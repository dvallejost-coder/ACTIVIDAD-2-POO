print("\n----- TRIANGULO RECTANGULO -----")
base = float(input("Ingrese base: "))
altura = float(input("Ingrese altura: "))
t = TrianguloRectangulo(base, altura)
print("Hipotenusa:", round(t.hipotenusa(), 2))
print("Área:", t.area())
print("Perímetro:", round(t.perimetro(), 2))
print("Tipo:", t.tipo_triangulo())

